---
import '../styles/global.css';
const { title } = Astro.props;
---
<!doctype html>
<html lang="ko" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="NX2803의 풀스택 엔지니어 포트폴리오. 시스템의 정교함과 사용자의 감각을 연결하는 인터페이스 빌더입니다." />
		<meta name="keywords" content="Portfolio, Full Stack, Engineer, Developer, React, Astro, Next.js, Spring Boot" />
		<meta property="og:title" content="NX280 | Trilogy Portfolio" />
		<meta property="og:description" content="시스템의 정교함과 사용자의 감각을 연결하는 인터페이스 빌더, NX2803의 프로젝트 포트폴리오입니다." />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Chiron+GoRound+TC&text=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789%20%21%40%23%24%25%5E%26%2A%28%29%2D%5F%3D%2B%5B%5D%7B%7D%3B%3A%27%22%2C%2E%3C%3E%2F%3F%5C%7C%60%7E&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;700&family=Geologica:wght@300;400;700;900&family=Outfit:wght@400;700&family=Inter:wght@400;600&family=Noto+Sans+KR:wght@400;700&family=Saira+Stencil+One&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body class="antialiased selection:bg-white selection:text-black">
		<slot />


	</body>
</html>
